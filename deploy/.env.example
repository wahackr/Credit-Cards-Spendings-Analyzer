# Manual local runs only:
#   docker compose --env-file deploy/.env -f deploy/compose.yaml up --build
# The CI pipeline ignores this file (it passes --env-file /dev/null) and reads the GitHub
# environment variables and secrets listed in deploy/README.md instead.
# Copy to deploy/.env and fill in a real key; never commit the result.

COMPOSE_PROJECT_NAME=credit-card-analyzer-dev
TZ=Asia/Hong_Kong

# The app has no authentication, so keep the loopback bind unless you deliberately want
# LAN access (which also needs APP_ALLOW_LAN_BIND=true in deploy.sh). Portainer already
# publishes 8000 on this host, hence 8010.
APP_BIND_ADDRESS=127.0.0.1
APP_HOST_PORT=8010
APP_ALLOW_LAN_BIND=false
APP_MEM_LIMIT=2g

# gemini or openai-compatible. The provider decides which of the keys below are required.
LLM_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-3-flash-preview

# OPENAI_BASE_URL=https://your-gateway.example/v1
# OPENAI_MODEL=your-model-name
# OPENAI_API_KEY=not-required
# OPENAI_THINKING=false
# OPENAI_MAX_OUTPUT_TOKENS=8192

MAX_CONCURRENT_STATEMENTS=2

# Prints every statement's extracted text and the model's answer to the container log.
LLM_DEBUG=false
